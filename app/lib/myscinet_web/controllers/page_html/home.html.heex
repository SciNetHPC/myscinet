<div class="grid grid-cols-1 gap-6">
  <%= if @vast do %>
    <% usable_tb = Map.get(@vast, :usable_capacity_tb, 0.0) %>
    <% free_tb = Map.get(@vast, :free_usable_capacity_tb, 0.0) %>
    <% used_tb = usable_tb - free_tb %>
    <% pct_used = if usable_tb > 0, do: 100.0 * used_tb / usable_tb, else: 0.0 %>
    <% rd_bw = Map.get(@vast, :rd_bw_mb, 0.0) %>
    <% wr_bw = Map.get(@vast, :wr_bw_mb, 0.0) %>
    <% rd_iops = Map.get(@vast, :rd_iops, 0.0) %>
    <% wr_iops = Map.get(@vast, :wr_iops, 0.0) %>
    <% rd_lat = Map.get(@vast, :rd_latency_ms, 0.0) %>
    <% wr_lat = Map.get(@vast, :wr_latency_ms, 0.0) %>
    <div class="card bg-base-200 shadow-sm">
      <div class="card-body grid grid-cols-6 gap-8 items-center">
        <div class="col-span-1">
          <h2 class="card-title">VastData</h2>
          <p class="badge badge-success">
            Online
          </p>
        </div>
        <div class="col-span-5">
          <div class="stats stats-horizontal">
            <div class="stat">
              <div class="stat-title">{gettext("Utilization")}</div>
              <div class={
                cond do
                  pct_used >= 80 -> "stat-value text-error"
                  pct_used >= 66 -> "stat-value text-warning"
                  true -> "stat-value"
                end
              }>
                {Float.round(pct_used, 1)}%
              </div>
            </div>
            <div class="stat">
              <div class="stat-title">{gettext("Capacity")}</div>
              <div class="stat-value text-sm">
                {Float.round(used_tb, 1)} / {Float.round(usable_tb, 1)} TB
              </div>
            </div>
            <div class="stat">
              <div class="stat-title">{gettext("Read BW")}</div>
              <div class="stat-value text-sm">{Float.round(rd_bw / 1024.0, 1)} GB/s</div>
            </div>
            <div class="stat">
              <div class="stat-title">{gettext("Write BW")}</div>
              <div class="stat-value text-sm">{Float.round(wr_bw / 1024.0, 1)} GB/s</div>
            </div>
            <div class="stat">
              <div class="stat-title">{gettext("Read IOPS")}</div>
              <div class="stat-value text-sm">{round(rd_iops)}</div>
            </div>
            <div class="stat">
              <div class="stat-title">{gettext("Write IOPS")}</div>
              <div class="stat-value text-sm">{round(wr_iops)}</div>
            </div>
            <div class="stat">
              <div class="stat-title">{gettext("Read Lat")}</div>
              <div class="stat-value text-sm">{Float.round(rd_lat, 2)} ms</div>
            </div>
            <div class="stat">
              <div class="stat-title">{gettext("Write Lat")}</div>
              <div class="stat-value text-sm">{Float.round(wr_lat, 2)} ms</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <% now = DateTime.utc_now() |> DateTime.to_unix() %>
  <%= for cluster <- @clusters do %>
    <a href={~p"/jobs/?q=cluster:#{cluster.slug_web}"} class="block">
      <div class="card bg-base-200 shadow-sm">
        <div class="card-body grid grid-cols-6 gap-8 items-center">
          <div class="col-span-1">
            <h2 class="card-title">{cluster.name}</h2>
            <% title =
              "Last update: " <>
                (DateTime.from_unix!(cluster.time) |> Calendar.strftime("%Y-%m-%d %H:%M:%S")) %>
            <%= if now - cluster.time < 600 do %>
              <p class="badge badge-success" title={title}>{gettext("Online")}</p>
            <% else %>
              <p class="badge badge-error" title={title}>{gettext("Stale")}</p>
            <% end %>
          </div>
          <div class="col-span-4">
            <div class="stats stats-horizontal">
              <div class="stat">
                <div class="stat-title">{gettext("Utilization")}</div>
                <% utilization = 100 * cluster.nodesRunning / cluster.nodes %>
                <div class={
                  cond do
                    utilization >= 95 -> "stat-value text-success"
                    utilization < 85 -> "stat-value text-error"
                    true -> "stat-value"
                  end
                }>
                  {Float.round(utilization, 1)}%
                </div>
              </div>
              <div class="stat">
                <div class="stat-title">{gettext("Jobs in Queue")}</div>
                <div class="stat-value">{MySciNetWeb.Clusters.total_jobs(cluster)}</div>
              </div>
              <div class="stat">
                <div class="stat-title">{gettext("Days of Work")}</div>
                <div class="stat-value">
                  {Float.round(MySciNetWeb.Clusters.days_of_work(cluster), 1)}
                </div>
              </div>
              <div class="stat">
                <div class="stat-title">{gettext("Login Nodes")}</div>
                <div class="stat-value">
                  <ul class="flex flex-row items-center">
                    <%= for {login_node, status} <- Enum.zip(cluster.logins, cluster.login_stats) do %>
                      <li class="flex items-center">
                        <% title =
                          "#{login_node}: " <>
                            if status,
                              do:
                                "Load #{status.load}, CPU #{status.cpu}%, Mem free: #{status.memfree}%",
                              else: "unknown" %>
                        <span title={title}>
                          <%= cond do %>
                            <% is_nil(status) -> %>
                              <.icon
                                name="hero-question-mark-circle-solid"
                                class="text-gray-400 mr-1"
                              />
                            <% status.cpu > 80.0 or status.memfree < 25.0 or status.load > 96.0 -> %>
                              <.icon
                                name="hero-exclamation-triangle-solid"
                                class="alert alert-error mr-1"
                              />
                            <% status.cpu > 50.0 or status.memfree < 50.0 or status.load > 48.0 -> %>
                              <.icon
                                name="hero-minus-circle-solid"
                                class="alert alert-warning mr-1"
                              />
                            <% true -> %>
                              <.icon
                                name="hero-check-circle-solid"
                                class="alert alert-success mr-1"
                              />
                          <% end %>
                        </span>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </a>
  <% end %>
</div>
